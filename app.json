{
  "expo": {
    "name": "MedRespons",
    "slug": "medrespons-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "id.medrespons.mobile"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan MedRespons menggunakan kamera untuk mengambil foto dokumentasi.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
